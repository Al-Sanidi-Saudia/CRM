""campaign_id"":""campaign.id"",""ad_group_id"":""ad_group.id""},""columns"":[[""customerid"",""id"",[""customer.id""],100],[""adid"",""id"",[""ad_group_ad.ad.id""],100],[""adname"",""str"",[""ad_group_ad.ad.name""],400],[""adgroupid"",""id"",[""ad_group.id""],100],[""campaignid"",""id"",[""campaign.id""],100],[""impressions"",""int"",[""metrics.impressions""],0],[""clicks"",""int"",[""metrics.clicks""],0],[""ctr"",""pct"",[""metrics.ctr""],0],[""averagecpc"",""money"",[""metrics.average_cpc""],0],[""averagecpm"",""money"",[""metrics.average_cpm""],0],[""averagecost"",""money"",[""metrics.average_cost""],0],[""cost"",""money"",[""metrics.cost_micros""],0],[""interactions"",""int"",[""metrics.interactions""],0],[""interactionrate"",""pct"",[""metrics.interaction_rate""],0],[""engagements"",""int"",[""metrics.engagements""],0],[""engagementrate"",""pct"",[""metrics.engagement_rate""],0],[""conversions"",""dec"",[""metrics.conversions""],0],[""conversionsvalue"",""cur"",[""metrics.conversions_value""],0],[""costperconversion"",""money"",[""metrics.cost_per_conversion""],0],[""valueperconversion"",""cur"",[""metrics.value_per_conversion""],0],[""conversionrate"",""pct"",[""metrics.conversions_from_interactions_rate""],0],[""allconversions"",""dec"",[""metrics.all_conversions""],0],[""allconversionsvalue"",""cur"",[""metrics.all_conversions_value""],0],[""viewthroughconversions"",""int"",[""metrics.view_through_conversions""],0],[""phonecalls"",""int"",[""metrics.phone_calls""],0],[""videoviews"",""int"",[""metrics.video_trueview_views""],0],[""videoviewrate"",""pct"",[""metrics.video_trueview_view_rate""],0],[""topimpressionpct"",""pct"",[""metrics.top_impression_percentage""],0],[""absolutetopimpressionpct"",""pct"",[""metrics.absolute_top_impression_percentage""],0]]}}}";
    // END GENERATED OPS

    private static readonly Regex Digits = new Regex("^[0-9]{1,20}$");
    private static readonly Regex IsoDate = new Regex("^[0-9]{4}-[0-9]{2}-[0-9]{2}$");
    private static readonly string[] DateRanges = {
        "TODAY", "YESTERDAY", "LAST_7_DAYS", "LAST_14_DAYS", "LAST_30_DAYS", "LAST_BUSINESS_WEEK",
        "LAST_WEEK_SUN_SAT", "LAST_WEEK_MON_SUN", "THIS_WEEK_SUN_TODAY", "THIS_WEEK_MON_TODAY",
        "THIS_MONTH", "LAST_MONTH" };

    private JObject ops;
    private Dictionary<string, string> query;

    public override async Task<HttpResponseMessage> ExecuteAsync()
    {
        try
        {
            ops = JObject.Parse(OpsJson);
            query = ParseQuery(Context.Request.RequestUri.Query);
            var operationId = OperationId();
            switch (operationId)
            {
                case "GetAccessToken": return await GetAccessToken().ConfigureAwait(false);
                case "ListAccessibleCustomers": return await ListAccessibleCustomers().ConfigureAwait(false);
                case "ListClientAccounts": return await ListClientAccounts().ConfigureAwait(false);
                case "RunQuery": return await RunQuery().ConfigureAwait(false);
                case "GetPerformance": return await GetPerformance().ConfigureAwait(false);
                default:
                    if (ops[operationId] is JObject op) return await ListEntities(op).ConfigureAwait(false);
                    return Error(HttpStatusCode.BadRequest, "Unknown operation '" + operationId + "'.");
            }
        }
        catch (GoogleAdsException ex)
        {
            return ex.Response;
        }
        catch (ArgumentException ex)
        {
            return Error(HttpStatusCode.BadRequest, ex.Message);
        }
    }

    // ---- operations ---------------------------------------------------------------------------

    private async Task<HttpResponseMessage> GetAccessToken()
    {
        var body = ParseJson(await Context.Request.Content.ReadAsStringAsync().ConfigureAwait(false));
        var form = new Dictionary<string, string> { ["grant_type"] = "refresh_token" };
        foreach (var name in new[] { "client_id", "client_secret", "refresh_token" })
        {
            var value = ((string)body[name] ?? "").Trim();
            if (value.Length == 0) throw new ArgumentException(name + " is required.");
            form[name] = value;
        }
        var request = new HttpRequestMessage(HttpMethod.Post, TokenUrl) { Content = new FormUrlEncodedContent(form) };
        var response = await Context.SendAsync(request, CancellationToken).ConfigureAwait(false);
        var text = await response.Content.ReadAsStringAsync().ConfigureAwait(false);
        if (!response.IsSuccessStatusCode)
        {
            // Google's token errors look like {"error":"invalid_grant","error_description":"..."}.
            string message;
            try
            {
                var e = ParseJson(text);
                message = ((string)e["error"] + ": " + (string)e["error_description"]).Trim(' ', ':');
            }
            catch (JsonException) { message = text; }
            return Error(response.StatusCode, "Google token request failed: " + message);
        }
        var token = ParseJson(text);
        return Ok(new JObject
        {
            ["access_token"] = token["access_token"],
            ["expires_in"] = token["expires_in"],
            ["token_type"] = token["token_type"],
            ["scope"] = token["scope"],
        });
    }

    private async Task<HttpResponseMessage> ListAccessibleCustomers()
    {
        var response = await Send(HttpMethod.Get, ApiBase + "customers:listAccessibleCustomers", null).ConfigureAwait(false);
        var ids = new JArray();
        foreach (var name in (JArray)response["resourceNames"] ?? new JArray())
            ids.Add(name.ToString().Replace("customers/", ""));
        return Ok(new JObject { ["resource_names"] = response["resourceNames"] ?? new JArray(), ["customer_ids"] = ids });
    }

    private async Task<HttpResponseMessage> ListClientAccounts()
    {
        var customerId = CustomerId();
        var where = new List<string>();
        if (!Flag("include_all_levels", false)) where.Add("customer_client.level <= 1");
        if (!Flag("include_managers", false)) where.Add("customer_client.manager = FALSE");
        if (!Flag("include_hidden", false)) where.Add("customer_client.hidden = FALSE");
        var gaql = "SELECT customer_client.id, customer_client.descriptive_name, customer_client.currency_code, " +
                   "customer_client.time_zone, customer_client.manager, customer_client.test_account, " +
                   "customer_client.level, customer_client.status, customer_client.hidden, " +
                   "customer_client.client_customer FROM customer_client" +
                   (where.Count > 0 ? " WHERE " + string.Join(" AND ", where) : "") +
                   " ORDER BY customer_client.level, customer_client.id";
        var rows = new JArray();
        foreach (var r in await Search(customerId, gaql, int.MaxValue).ConfigureAwait(false))
        {
            var c = r["customerClient"] ?? new JObject();
            rows.Add(new JObject
            {
                ["customer_id"] = c["id"]?.ToString(),
                ["name"] = c["descriptiveName"],
                ["currency_code"] = c["currencyCode"],
                ["time_zone"] = c["timeZone"],
                ["manager"] = c["manager"]?.Value<bool>() ?? false,
                ["test_account"] = c["testAccount"]?.Value<bool>() ?? false,
                ["level"] = c["level"] != null ? c["level"].Value<long>() : 0,
                ["status"] = c["status"],
                ["hidden"] = c["hidden"]?.Value<bool>() ?? false,
                ["resource_name"] = c["clientCustomer"],
            });
        }
        return Ok(new JObject { ["customer_id"] = customerId, ["row_count"] = rows.Count, ["rows"] = rows });
    }

    private async Task<HttpResponseMessage> ListEntities(JObject op)
    {
        var customerId = CustomerId();
        var resource = (string)op["resource"];
        var key = (string)op["key"];
        var columns = (JArray)op["columns"];

        var where = new List<string>();
        foreach (var f in (JObject)op["filters"])
        {
            var value = Param(f.Key);
            if (string.IsNullOrEmpty(value)) continue;
            if (!Digits.IsMatch(value)) throw new ArgumentException(f.Key + " must be a numeric ID.");
            where.Add(f.Value + " = " + value);
        }
        var status = (Param("status") ?? "ALL").ToUpperInvariant();
        var statusField = (string)op["status"];
        if (status == "NOT_REMOVED") where.Add(statusField + " != 'REMOVED'");
        else if (status == "ENABLED" || status == "PAUSED" || status == "REMOVED") where.Add(statusField + " = '" + status + "'");
        else if (status != "ALL") throw new ArgumentException("status must be ALL, NOT_REMOVED, ENABLED, PAUSED or REMOVED.");
        var whereClause = where.Count > 0 ? " WHERE " + string.Join(" AND ", where) : "";
        var maxRows = MaxRows();

        var attributes = Fields(columns, false);
        if (!attributes.Contains(key)) attributes.Insert(0, key);
        var rows = await Search(customerId,
            "SELECT " + string.Join(", ", attributes) + " FROM " + resource + whereClause + " ORDER BY " + key,
            maxRows).ConfigureAwait(false);

        // Metrics come from a second query: a resource query that selects metrics skips rows with no
        // activity, and paused or new entities must still sync. No date filter = all-time totals.
        var metricsByKey = new Dictionary<string, JToken>();
        string metricsError = null;
        var metricFields = Fields(columns, true);
        if (metricFields.Count > 0 && Flag("include_metrics", true) && rows.Count > 0)
        {
            try
            {
                var metricRows = await Search(customerId,
                    "SELECT " + key + ", " + string.Join(", ", metricFields) + " FROM " + resource + whereClause,
                    int.MaxValue).ConfigureAwait(false);
                foreach (var m in metricRows) metricsByKey[Read(m, key)?.ToString() ?? ""] = m["metrics"];
            }
            catch (GoogleAdsException ex)
            {
                metricsError = ex.Message;
            }
        }

        var output = new JArray();
        foreach (var row in rows)
        {
            if (metricsByKey.TryGetValue(Read(row, key)?.ToString() ?? "", out var metrics)) row["metrics"] = metrics;
            else if (metricFields.Count > 0 && metricsError == null && Flag("include_metrics", true)) row["metrics"] = new JObject();
            output.Add(Flatten(row, columns));
        }
        var result = new JObject { ["customer_id"] = customerId, ["row_count"] = output.Count, ["rows"] = output };
        if (metricsError != null) result["metrics_error"] = metricsError;
        return Ok(result);
    }

    private async Task<HttpResponseMessage> GetPerformance()
    {
        var customerId = CustomerId();
        var level = (Param("level") ?? "campaign").ToLowerInvariant();
        var perf = ops["$performance"]?[level] as JObject;
        if (perf == null) throw new ArgumentException("level must be campaign, ad_group or ad.");
        var columns = (JArray)perf["columns"];

        var segments = new List<string>();
        var granularity = (Param("granularity") ?? "TOTAL").ToUpperInvariant();
        if (granularity == "DAILY") segments.Add("segments.date");
        else if (granularity == "WEEKLY") segments.Add("segments.week");
        else if (granularity == "MONTHLY") segments.Add("segments.month");
        else if (granularity != "TOTAL") throw new ArgumentException("granularity must be TOTAL, DAILY, WEEKLY or MONTHLY.");
        var breakdown = (Param("breakdown") ?? "NONE").ToUpperInvariant();
        if (breakdown == "DEVICE") segments.Add("segments.device");
        else if (breakdown == "AD_NETWORK_TYPE") segments.Add("segments.ad_network_type");
        else if (breakdown != "NONE") throw new ArgumentException("breakdown must be NONE, DEVICE or AD_NETWORK_TYPE.");

        var where = new List<string>();
        var start = Param("start_date");
        var end = Param("end_date");
        if (!string.IsNullOrEmpty(start) || !string.IsNullOrEmpty(end))
        {
            if (!IsoDate.IsMatch(start ?? "") || !IsoDate.IsMatch(end ?? ""))
                throw new ArgumentException("start_date and end_date must both be YYYY-MM-DD.");
            where.Add("segments.date BETWEEN '" + start + "' AND '" + end + "'");
        }
        else
        {
            var range = (Param("date_range") ?? "LAST_30_DAYS").ToUpperInvariant();
            if (range != "ALL_TIME")
            {
                if (!DateRanges.Contains(range)) throw new ArgumentException("Unsupported date_range '" + range + "'.");
                where.Add("segments.date DURING " + range);
            }
            else if (segments.Any(s => s.StartsWith("segments.date") || s == "segments.week" || s == "segments.month"))
                throw new ArgumentException("A DAILY/WEEKLY/MONTHLY breakdown needs a date range.");
        }
        foreach (var f in (JObject)perf["filters"])
        {
            var value = Param(f.Key);
            if (string.IsNullOrEmpty(value)) continue;
            if (!Digits.IsMatch(value)) throw new ArgumentException(f.Key + " must be a numeric ID.");
            where.Add(f.Value + " = " + value);
        }

        var fields = Fields(columns, false).Concat(segments).Concat(Fields(columns, true)).ToList();
        var gaql = "SELECT " + string.Join(", ", fields) + " FROM " + (string)perf["resource"] +
                   (where.Count > 0 ? " WHERE " + string.Join(" AND ", where) : "");
        var output = new JArray();
        foreach (var row in await Search(customerId, gaql, MaxRows()).ConfigureAwait(false))
        {
            var flat = Flatten(row, columns);
            flat.Remove("rawpayload");
            var seg = row["segments"];
            if (seg != null)
            {
                if (seg["date"] != null) flat["date"] = seg["date"];
                if (seg["week"] != null) flat["week"] = seg["week"];
                if (seg["month"] != null) flat["month"] = seg["month"];
                if (seg["device"] != null) flat["device"] = seg["device"];
                if (seg["adNetworkType"] != null) flat["ad_network_type"] = seg["adNetworkType"];
            }
            output.Add(flat);
        }
        return Ok(new JObject { ["customer_id"] = customerId, ["query"] = gaql, ["row_count"] = output.Count, ["rows"] = output });
    }

    private async Task<HttpResponseMessage> RunQuery()
    {
        var customerId = CustomerId();
        var body = ParseJson(await Context.Request.Content.ReadAsStringAsync().ConfigureAwait(false));
        var gaql = (string)body["query"];
        if (string.IsNullOrWhiteSpace(gaql)) throw new ArgumentException("query is required.");
        var maxRows = body["max_rows"] != null ? body["max_rows"].Value<int>() : 10000;
        var flatten = body["flatten"] == null || body["flatten"].Value<bool>();
        var rows = await Search(customerId, gaql, maxRows).ConfigureAwait(false);
        var output = new JArray();
        foreach (var row in rows)
        {
            if (!flatten) { output.Add(row); continue; }
            var flat = new JObject();
            FlattenGeneric(row, "", flat);
            output.Add(flat);
        }
        return Ok(new JObject { ["customer_id"] = customerId, ["query"] = gaql, ["row_count"] = output.Count, ["rows"] = output });
    }

    // ---- Google Ads calls -----------------------------------------------------------------------

    private async Task<List<JObject>> Search(string customerId, string gaql, int maxRows)
    {
        var rows = new List<JObject>();
        string pageToken = null;
        do
        {
            var body = new JObject { ["query"] = gaql };
            if (!string.IsNullOrEmpty(pageToken)) body["pageToken"] = pageToken;
            var page = await Send(HttpMethod.Post, ApiBase + "customers/" + customerId + "/googleAds:search", body).ConfigureAwait(false);
            foreach (JObject r in (JArray)page["results"] ?? new JArray())
            {
                rows.Add(r);
                if (rows.Count >= maxRows) return rows;
            }
            pageToken = (string)page["nextPageToken"];
        } while (!string.IsNullOrEmpty(pageToken));
        return rows;
    }

    private async Task<JObject> Send(HttpMethod method, string url, JObject body)
    {
        var request = new HttpRequestMessage(method, url);
        var accessToken = Header("access-token");
        if (string.IsNullOrWhiteSpace(accessToken)) throw new ArgumentException("access-token is required (use Get access token).");
        accessToken = accessToken.Trim();
        if (accessToken.StartsWith("Bearer ", StringComparison.OrdinalIgnoreCase)) accessToken = accessToken.Substring(7).Trim();
        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", accessToken);
        var developerToken = Header("developer-token");
        if (string.IsNullOrWhiteSpace(developerToken)) throw new ArgumentException("developer-token is required.");
        request.Headers.TryAddWithoutValidation("developer-token", developerToken.Trim());
        var login = Header("login-customer-id");
        if (!string.IsNullOrEmpty(login))
        {
            login = login.Replace("-", "").Trim();
            if (!Digits.IsMatch(login)) throw new ArgumentException("login-customer-id must be a numeric customer ID.");
            request.Headers.TryAddWithoutValidation("login-customer-id", login);
        }
        if (body != null) request.Content = CreateJsonContent(body.ToString(Newtonsoft.Json.Formatting.None));
        var response = await Context.SendAsync(request, CancellationToken).ConfigureAwait(false);
        var text = response.Content != null ? await response.Content.ReadAsStringAsync().ConfigureAwait(false) : "";
        if (!response.IsSuccessStatusCode) throw new GoogleAdsException(response.StatusCode, text);
        return string.IsNullOrWhiteSpace(text) ? new JObject() : ParseJson(text);
    }

    // Google returns date-times as "yyyy-MM-dd HH:mm:ss" strings; keep them as text.
    private static JObject ParseJson(string text)
    {
        using (var reader = new JsonTextReader(new StringReader(text)) { DateParseHandling = DateParseHandling.None })
            return JObject.Load(reader);
    }

    // ---- flattening -----------------------------------------------------------------------------

    private static List<string> Fields(JArray columns, bool metrics)
    {
        var fields = new List<string>();
        foreach (JArray c in columns)
            foreach (var s in (JArray)c[2])
            {
                var f = (string)s;
                if (f.StartsWith("metrics.") == metrics && !fields.Contains(f)) fields.Add(f);
            }
        return fields;
    }

    private static JObject Flatten(JObject row, JArray columns)
    {
        var flat = new JObject();
        foreach (JArray c in columns)
        {
            var name = (string)c[0];
            var kind = (string)c[1];
            var maxLength = c.Count > 3 ? (int)c[3] : 0;
            if (kind == "now") { flat[name] = DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ"); continue; }
            if (kind == "raw")
            {
                var copy = (JObject)row.DeepClone();
                copy.Remove("metrics");
                flat[name] = Truncate(copy.ToString(Newtonsoft.Json.Formatting.None), RawPayloadMaxLength);
                continue;
            }
            JToken value = null;
            foreach (var s in (JArray)c[2])
            {
                value = Read(row, (string)s);
                if (!IsEmpty(value)) break;
            }
            flat[name] = Convert(value, kind, maxLength);
        }
        return flat;
    }

    private static JToken Convert(JToken v, string kind, int maxLength)
    {
        if (IsEmpty(v)) return kind == "enums" ? (JToken)new JArray() : JValue.CreateNull();
        switch (kind)
        {
            case "str":
            case "id":
                return Truncate((v is JArray a ? a.First : v).ToString(), maxLength);
            case "int": return v.Value<long>();
            case "dec": return Math.Round(v.Value<double>(), 6);
            case "cur": return Math.Round(v.Value<double>(), 4);
            case "money": return Math.Round(v.Value<double>() / 1000000.0, 4);
            case "pct": return Math.Round(v.Value<double>() * 100.0, 4);
            case "pctmicros": return Math.Round(v.Value<double>() / 10000.0, 4);
            case "bool": return v.Value<bool>();
            case "date":
                var d = v.ToString().Trim();
                if (d.Length == 10) d += " 00:00:00";
                return d.Replace(' ', 'T');
            case "enum": return v.ToString();
            case "enums": return v is JArray ? v : new JArray(v);
            case "strs": return Truncate(string.Join("\n", (v is JArray l ? l : new JArray(v)).Select(x => x.ToString())), maxLength);
            case "json": return Truncate(v.ToString(Newtonsoft.Json.Formatting.None), maxLength);
            case "texts": return Truncate(string.Join("\n", Items(v).Select(x => x is JObject o ? (string)o["text"] : x.ToString()).Where(x => !string.IsNullOrEmpty(x))), maxLength);
            case "assets": return Truncate(string.Join("\n", Items(v).Select(x => x is JObject o ? (string)o["asset"] : x.ToString()).Where(x => !string.IsNullOrEmpty(x))), maxLength);
            default: return v;
        }
    }

    private static IEnumerable<JToken> Items(JToken v) => v is JArray a ? (IEnumerable<JToken>)a : new[] { v };

    private static void FlattenGeneric(JToken token, string prefix, JObject into)
    {
        if (token is JObject o)
        {
            foreach (var p in o.Properties())
                FlattenGeneric(p.Value, prefix.Length == 0 ? Snake(p.Name) : prefix + "_" + Snake(p.Name), into);
        }
        else into[prefix] = token;
    }

    // "campaign_budget.amount_micros" -> row["campaignBudget"]["amountMicros"]
    private static JToken Read(JToken row, string field)
    {
        JToken current = row;
        foreach (var part in field.Split('.'))
        {
            if (!(current is JObject o)) return null;
            current = o[Camel(part)];
            if (current == null) return null;
        }
        return current;
    }

    private static string Camel(string snake)
    {
        var parts = snake.Split('_');
        return parts[0] + string.Concat(parts.Skip(1).Select(p => p.Length == 0 ? "" : char.ToUpperInvariant(p[0]) + p.Substring(1)));
    }

    private static string Snake(string camel) => Regex.Replace(camel, "([a-z0-9])([A-Z])", "$1_$2").ToLowerInvariant();

    private static bool IsEmpty(JToken v) =>
        v == null || v.Type == JTokenType.Null || (v is JArray a && a.Count == 0) ||
        (v.Type == JTokenType.String && v.ToString().Length == 0);

    private static string Truncate(string s, int maxLength) =>
        maxLength > 0 && s != null && s.Length > maxLength ? s.Substring(0, maxLength) : s;

    // ---- request helpers ------------------------------------------------------------------------

    private string OperationId()
    {
        var id = Context.OperationId;
        if (ops[id] != null || id.StartsWith("List") || id.StartsWith("Get") || id == "RunQuery") return id;
        try { return Encoding.UTF8.GetString(System.Convert.FromBase64String(id)); }
        catch (FormatException) { return id; }
    }

    private string CustomerId()
    {
        // Custom paths look like /customers/{customer_id}/...
        var segments = Context.Request.RequestUri.AbsolutePath.Split('/');
        var i = Array.IndexOf(segments, "customers");
        var id = i >= 0 && i + 1 < segments.Length ? Uri.UnescapeDataString(segments[i + 1]).Replace("-", "").Trim() : "";
        if (!Digits.IsMatch(id)) throw new ArgumentException("customer_id must be a Google Ads customer ID (10 digits, dashes allowed).");
        return id;
    }

    private string Param(string name) => query.TryGetValue(name, out var v) ? v : null;

    private bool Flag(string name, bool fallback)
    {
        var v = Param(name);
        return string.IsNullOrEmpty(v) ? fallback : v.Equals("true", StringComparison.OrdinalIgnoreCase);
    }

    private int MaxRows()
    {
        var v = Param("max_rows");
        return string.IsNullOrEmpty(v) ? int.MaxValue : Math.Max(1, int.Parse(v));
    }

    private string Header(string name) =>
        Context.Request.Headers.TryGetValues(name, out var values) ? values.FirstOrDefault() : null;

    private static Dictionary<string, string> ParseQuery(string q)
    {
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var pair in (q ?? "").TrimStart('?').Split(new[] { '&' }, StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = pair.Split(new[] { '=' }, 2);
            result[Uri.UnescapeDataString(kv[0].Replace('+', ' '))] =
                kv.Length > 1 ? Uri.UnescapeDataString(kv[1].Replace('+', ' ')) : "";
        }
        return result;
    }

    private HttpResponseMessage Ok(JObject body)
    {
        var response = new HttpResponseMessage(HttpStatusCode.OK);
        response.Content = CreateJsonContent(body.ToString(Newtonsoft.Json.Formatting.None));
        return response;
    }

    private HttpResponseMessage Error(HttpStatusCode status, string message)
    {
        var response = new HttpResponseMessage(status);
        response.Content = CreateJsonContent(new JObject
        {
            ["error"] = new JObject { ["code"] = (int)status, ["message"] = message, ["status"] = status.ToString() }
        }.ToString(Newtonsoft.Json.Formatting.None));
        return response;
    }

    private class GoogleAdsException : Exception
    {
        public HttpResponseMessage Response { get; }

        public GoogleAdsException(HttpStatusCode status, string body) : base(Describe(body))
        {
            Response = new HttpResponseMessage(status) { Content = new StringContent(body, Encoding.UTF8, "application/json") };
        }

        private static string Describe(string body)
        {
            try
            {
                var e = JObject.Parse(body)["error"];
                var detail = e?["details"]?.First?["errors"]?.First?["message"];
                return (string)(detail ?? e?["message"]) ?? body;
            }
            catch (JsonException) { return body; }
        }
    }
}
