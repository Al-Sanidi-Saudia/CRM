              "EXCELLENT": 2,
              "GOOD": 3,
              "NO_ADS": 4,
              "PENDING": 5,
              "POOR": 6,
              "UNKNOWN": 7,
              "UNSPECIFIED": 8
            }
          },
          "description": "Google Ads value -> Dataverse option value for every choice column"
