            "sanidi_primarystatus": {
              "ELIGIBLE": 1,
              "LIMITED": 2,
              "NOT_ELIGIBLE": 3,
              "PAUSED": 4,
              "PENDING": 5,
              "REMOVED": 6,
              "UNKNOWN": 7,
              "UNSPECIFIED": 8
            },
            "sanidi_primarystatusreasons": {
              "ASSET_GROUP_DISAPPROVED": 1,
              "ASSET_GROUP_LIMITED": 2,
              "ASSET_GROUP_PAUSED": 3,
              "ASSET_GROUP_REMOVED": 4,
              "ASSET_GROUP_UNDER_REVIEW": 5,
              "CAMPAIGN_ENDED": 6,
              "CAMPAIGN_PAUSED": 7,
              "CAMPAIGN_PENDING": 8,
