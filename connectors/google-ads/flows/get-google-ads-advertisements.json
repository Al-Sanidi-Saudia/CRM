              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "sanidi_googleadsadvertisements",
                  "$select": "sanidi_googleadsadvertisementid",
                  "$filter": "sanidi_adid eq '@{items('For_each_ad')?['adid']}'",
                  "$top": 1
