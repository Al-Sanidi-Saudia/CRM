              "type": "Select",
              "inputs": {
                "from": "@coalesce(items('For_each_ad')?['autodisclaimertypes'], json('[]'))",
                "select": "@outputs('Choice_maps')?['sanidi_autodisclaimertypes']?[item()]"
              },
              "runAfter": {}
            },
            "Known_autodisclaimertypes": {
              "type": "Query",
              "inputs": {
                "from": "@body('Known_autodisclaimertypes_values')",
                "where": "@not(equals(item(), null))"
