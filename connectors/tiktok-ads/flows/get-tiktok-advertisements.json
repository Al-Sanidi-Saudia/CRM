        "List_ads": {
          "runAfter": {
            "Choice_maps": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "Access-Token": "@trim(parameters('TikTok Ads Access Token (sanidi_TikTokAdsAccessToken)'))",
              "advertiser_id": "@triggerOutputs()?['body/sanidi_advertiserid']",
              "adgroup_id": "@triggerOutputs()?['body/sanidi_adgroupid']",
              "include_deleted": true
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sanidi-5ftiktok-5f43b530b23a0dc933",
              "operationId": "ListAds",
              "connectionName": "shared_sanidi-5ftiktok-5f43b530b23a0dc933"
            }
          }
        },
        "For_each_ad": {
          "type": "Foreach",
          "foreach": "@coalesce(outputs('List_ads')?['body/rows'], json('[]'))",
          "runAfter": {
            "List_ads": [
              "Succeeded"
            ]
          },
          "actions": {
