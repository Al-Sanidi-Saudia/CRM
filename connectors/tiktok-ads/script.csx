_value_per_find_location""],[""websitetotalfindlocationvalue"",""money"",""website_total_find_location_value""],[""websitetotalschedule"",""int"",""website_total_schedule""],[""websitecostperschedule"",""money"",""website_cost_per_schedule""],[""websiteschedulerate"",""pct"",""website_schedule_rate""],[""websitevalueperschedule"",""money"",""website_value_per_schedule""],[""websitetotalschedulevalue"",""money"",""website_total_schedule_value""],[""websitetotalcustomizeproduct"",""int"",""website_total_customize_product""],[""websitecostpercustomizeproduct"",""money"",""website_cost_per_customize_product""],[""websitecustomizeproductrate"",""pct"",""website_customize_product_rate""],[""websitevaluepercustomizeproduct"",""money"",""website_value_per_customize_product""],[""websitetotalcustomizeproductvalue"",""money"",""website_total_customize_product_value""],[""vtaconversion"",""int"",""vta_conversion""],[""costpervtaconversion"",""money"",""cost_per_vta_conversion""],[""ctaconversion"",""int"",""cta_conversion""],[""costperctaconversion"",""money"",""cost_per_cta_conversion""],[""engagedviewthroughconversions"",""int"",""engaged_view_through_conversions""],[""costperengagedviewthroughconversion"",""money"",""cost_per_engaged_view_through_conversion""],[""vtaappinstall"",""int"",""vta_app_install""],[""costpervtaappinstall"",""money"",""cost_per_vta_app_install""],[""ctaappinstall"",""int"",""cta_app_install""],[""costperctaappinstall"",""money"",""cost_per_cta_app_install""],[""evtaappinstall"",""int"",""evta_app_install""],[""costperevtaappinstall"",""money"",""cost_per_evta_app_install""],[""vtaregistration"",""int"",""vta_registration""],[""costpervtaregistration"",""money"",""cost_per_vta_registration""],[""ctaregistration"",""int"",""cta_registration""],[""costperctaregistration"",""money"",""cost_per_cta_registration""],[""evtaregistration"",""int"",""evta_registration""],[""costperevtaregistration"",""money"",""cost_per_evta_registration""],[""vtapurchase"",""int"",""vta_purchase""],[""costpervtapurchase"",""money"",""cost_per_vta_purchase""],[""ctapurchase"",""int"",""cta_purchase""],[""costperctapurchase"",""money"",""cost_per_cta_purchase""],[""evtapurchase"",""int"",""evta_purchase""],[""costperevtapurchase"",""money"",""cost_per_evta_purchase""],[""vtacompletepayment"",""int"",""vta_complete_payment""],[""costpervtapaymentscompleted"",""money"",""cost_per_vta_payments_completed""],[""evtapaymentscompleted"",""int"",""evta_payments_completed""],[""costperevtapaymentscompleted"",""money"",""cost_per_evta_payments_completed""],[""vtacompletepaymentvalue"",""money"",""vta_complete_payment_value""],[""vtacompletepaymentroas"",""dec"",""vta_complete_payment_roas""]],""$insights"":{""campaign"":{""data_level"":""AUCTION_CAMPAIGN"",""dimension"":""campaign_id"",""id_column"":""campaignid""},""adgroup"":{""data_level"":""AUCTION_ADGROUP"",""dimension"":""adgroup_id"",""id_column"":""adgroupid""},""ad"":{""data_level"":""AUCTION_AD"",""dimension"":""ad_id"",""id_column"":""adid""}}}";
    // END GENERATED OPS

    private static readonly Regex Digits = new Regex("^[0-9]{1,25}$");
    private static readonly int[] RateLimitCodes = { 40100, 40133, 50002 };

    private JObject ops;
    private Dictionary<string, string> query;

    public override async Task<HttpResponseMessage> ExecuteAsync()
    {
        try
        {
            ops = JObject.Parse(OpsJson);
            query = ParseQuery(Context.Request.RequestUri.Query);
            switch (OperationId())
            {
                case "GetAccessToken": return await GetAccessToken().ConfigureAwait(false);
                case "ListAuthorizedAdvertisers": return await ListAuthorizedAdvertisers().ConfigureAwait(false);
                case "GetAdvertiserInfo": return await GetAdvertiserInfo().ConfigureAwait(false);
                case "ListCampaigns": return await ListEntities("campaign").ConfigureAwait(false);
                case "ListAdGroups": return await ListEntities("adgroup").ConfigureAwait(false);
                case "ListAds": return await ListEntities("ad").ConfigureAwait(false);
                case "GetLifetimeInsights": return await GetLifetimeInsights().ConfigureAwait(false);
                case "RunReport": return await RunReport().ConfigureAwait(false);
                default: return Error(HttpStatusCode.BadRequest, "Unknown operation '" + Context.OperationId + "'.");
            }
        }
        catch (TikTokException ex)
        {
            return Error(ex.Status, ex.Message);
        }
        catch (ArgumentException ex)
        {
            return Error(HttpStatusCode.BadRequest, ex.Message);
        }
    }

    // ---- operations ---------------------------------------------------------------------------

    private async Task<HttpResponseMessage> GetAccessToken()
    {
        var body = ParseJson(await Context.Request.Content.ReadAsStringAsync().ConfigureAwait(false));
        var payload = new JObject();
        foreach (var name in new[] { "app_id", "secret", "auth_code" })
        {
            var value = ((string)body[name] ?? "").Trim();
            if (value.Length == 0) throw new ArgumentException(name + " is required.");
            payload[name] = value;
        }
        var data = await Call(HttpMethod.Post, "oauth2/access_token/", null, payload, false).ConfigureAwait(false);
        var ids = (JArray)data["advertiser_ids"] ?? new JArray();
        return Ok(new JObject
        {
            ["access_token"] = data["access_token"],
            ["scope"] = data["scope"],
            ["advertiser_ids"] = ids,
            ["advertiser_ids_text"] = string.Join(",", ids.Select(x => x.ToString())),
        });
    }

    private async Task<HttpResponseMessage> ListAuthorizedAdvertisers()
    {
        var data = await Call(HttpMethod.Get, "oauth2/advertiser/get/", new Dictionary<string, string>
        {
            ["app_id"] = Required("app_id"),
            ["secret"] = Required("secret"),
        }, null, true).ConfigureAwait(false);
        var rows = new JArray();
        foreach (JObject a in (JArray)data["list"] ?? new JArray())
            rows.Add(new JObject { ["advertiser_id"] = a["advertiser_id"]?.ToString(), ["advertiser_name"] = a["advertiser_name"] });
        return Ok(new JObject
        {
            ["row_count"] = rows.Count,
            ["advertiser_ids_text"] = string.Join(",", rows.Select(r => (string)r["advertiser_id"])),
            ["rows"] = rows,
        });
    }

    private async Task<HttpResponseMessage> GetAdvertiserInfo()
    {
        var info = await AdvertiserInfo(AdvertiserId()).ConfigureAwait(false);
        return Ok(info);
    }

    private async Task<JObject> AdvertiserInfo(string advertiserId)
    {
        var data = await Call(HttpMethod.Get, "advertiser/info/", new Dictionary<string, string>
        {
            ["advertiser_ids"] = new JArray(advertiserId).ToString(Newtonsoft.Json.Formatting.None),
        }, null, true).ConfigureAwait(false);
        var a = ((JArray)data["list"])?.FirstOrDefault() as JObject ?? new JObject();
        return new JObject
        {
            ["advertiser_id"] = advertiserId,
            ["name"] = a["name"],
            ["currency"] = a["currency"],
            ["display_timezone"] = a["display_timezone"],
            ["timezone"] = a["timezone"],
            ["status"] = a["status"],
            ["company"] = a["company"],
            ["country"] = a["country"],
        };
    }

    // Campaigns / ad groups / ads, all pages. Deleted items are left out by TikTok by default, so with
    // include_deleted they are read with a second query (primary_status = STATUS_DELETE) and merged.
    private async Task<HttpResponseMessage> ListEntities(string level)
    {
        var op = (JObject)ops[level];
        var advertiserId = AdvertiserId();
        var filtering = new JObject();
        foreach (var f in (JObject)op["filters"])
        {
            var value = Param(f.Key);
            if (string.IsNullOrEmpty(value)) continue;
            if (!Digits.IsMatch(value)) throw new ArgumentException(f.Key + " must be a numeric ID.");
            filtering[(string)f.Value] = new JArray(value);
        }
        var maxRows = MaxRows();
        var rows = await ListAll(op, advertiserId, filtering, maxRows).ConfigureAwait(false);
        if (Flag("include_deleted", true) && rows.Count < maxRows)
        {
            var deletedFilter = (JObject)filtering.DeepClone();
            deletedFilter["primary_status"] = "STATUS_DELETE";
            var seen = new HashSet<string>(rows.Select(r => r[(string)op["id"]]?.ToString()));
            foreach (var r in await ListAll(op, advertiserId, deletedFilter, maxRows - rows.Count).ConfigureAwait(false))
                if (seen.Add(r[(string)op["id"]]?.ToString())) rows.Add(r);
        }

        JObject info = null;
        var columns = (JArray)op["columns"];
        if (columns.Any(c => (string)c[1] == "info") && rows.Count > 0)
            info = await AdvertiserInfo(advertiserId).ConfigureAwait(false);

        var output = new JArray();
        foreach (var r in rows) output.Add(Flatten(r, columns, info));
        return Ok(new JObject { ["advertiser_id"] = advertiserId, ["row_count"] = output.Count, ["rows"] = output });
    }

    private async Task<List<JObject>> ListAll(JObject op, string advertiserId, JObject filtering, int maxRows)
    {
        var rows = new List<JObject>();
        for (var page = 1; ; page++)
        {
            var args = new Dictionary<string, string>
            {
                ["advertiser_id"] = advertiserId,
                ["page"] = page.ToString(),
                ["page_size"] = PageSize.ToString(),
            };
            if (filtering.Count > 0) args["filtering"] = filtering.ToString(Newtonsoft.Json.Formatting.None);
            var data = await Call(HttpMethod.Get, (string)op["path"], args, null, true).ConfigureAwait(false);
            foreach (JObject r in (JArray)data["list"] ?? new JArray())
            {
                rows.Add(r);
                if (rows.Count >= maxRows) return rows;
            }
            var totalPages = data["page_info"]?["total_page"]?.Value<int>() ?? 1;
            if (page >= totalPages) return rows;
        }
    }

    // All-time (lifetime) metrics for every campaign / ad group / ad of an advertiser, one row per item,
    // keyed by the Dataverse column names. Metrics are requested in chunks and merged by item ID.
    private async Task<HttpResponseMessage> GetLifetimeInsights()
    {
        var advertiserId = AdvertiserId();
        var level = (Param("level") ?? "campaign").ToLowerInvariant();
        var cfg = ops["$insights"][level] as JObject;
        if (cfg == null) throw new ArgumentException("level must be campaign, adgroup or ad.");
        var dimension = (string)cfg["dimension"];
        var idColumn = (string)cfg["id_column"];
        var metrics = (JArray)ops["$metrics"];

        var byId = new Dictionary<string, JObject>();
        var order = new List<string>();
        string metricsError = null;
        var now = DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ");
        // A refused chunk is split in half and retried, so one metric TikTok rejects at this level only
        // drops itself (reported in metrics_error), not the whole chunk.
        var pending = new Queue<List<JArray>>(Chunks(metrics.Cast<JArray>().ToList(), MetricsPerRequest));
        while (pending.Count > 0)
        {
            var chunk = pending.Dequeue();
            var names = new JArray(chunk.Select(m => (string)m[2]));
            List<JObject> reportRows;
            try
            {
                reportRows = await Report(advertiserId, new Dictionary<string, string>
                {
                    ["report_type"] = "BASIC",
                    ["data_level"] = (string)cfg["data_level"],
                    ["dimensions"] = new JArray(dimension).ToString(Newtonsoft.Json.Formatting.None),
                    ["metrics"] = names.ToString(Newtonsoft.Json.Formatting.None),
                    ["query_lifetime"] = "true",
                }, int.MaxValue).ConfigureAwait(false);
            }
            catch (TikTokException ex) when (ex.Code != 0 && !RateLimitCodes.Contains(ex.Code))
            {
                if (chunk.Count > 1)
                {
                    var half = chunk.Count / 2;
                    pending.Enqueue(chunk.GetRange(0, half));
                    pending.Enqueue(chunk.GetRange(half, chunk.Count - half));
                }
                else
                {
                    metricsError = (metricsError == null ? "" : metricsError + " | ") + (string)names[0] + ": " + ex.Message;
                }
                continue;
            }
            foreach (var r in reportRows)
            {
                var id = r["dimensions"]?[dimension]?.ToString();
                if (string.IsNullOrEmpty(id)) continue;
                if (!byId.TryGetValue(id, out var row))
                {
                    row = new JObject { [idColumn] = id, ["advertiserid"] = advertiserId, ["insightslastsyncedon"] = now };
                    byId[id] = row;
                    order.Add(id);
                }
                var values = r["metrics"] as JObject ?? new JObject();
                foreach (var m in chunk)
                    row[(string)m[0]] = Convert(values[(string)m[2]], (string)m[1], 0);
            }
        }
        var rows = new JArray(order.Select(id => byId[id]));
        var result = new JObject { ["advertiser_id"] = advertiserId, ["level"] = level, ["row_count"] = rows.Count, ["rows"] = rows };
        if (metricsError != null) result["metrics_error"] = metricsError;
        return Ok(result);
    }

    private async Task<HttpResponseMessage> RunReport()
    {
        var body = ParseJson(await Context.Request.Content.ReadAsStringAsync().ConfigureAwait(false));
        var advertiserId = ((string)body["advertiser_id"] ?? "").Trim();
        if (!Digits.IsMatch(advertiserId)) throw new ArgumentException("advertiser_id must be a TikTok advertiser ID.");
        var args = new Dictionary<string, string>
        {
            ["report_type"] = (string)body["report_type"] ?? "BASIC",
            ["data_level"] = (string)body["data_level"] ?? "AUCTION_CAMPAIGN",
        };
        foreach (var name in new[] { "dimensions", "metrics", "filtering" })
            if (body[name] != null && body[name].Type != JTokenType.Null)
                args[name] = body[name].Type == JTokenType.String ? (string)body[name] : body[name].ToString(Newtonsoft.Json.Formatting.None);
        if (!args.ContainsKey("dimensions")) throw new ArgumentException("dimensions is required, e.g. [\"campaign_id\"].");
        if (body["query_lifetime"]?.Value<bool>() == true) args["query_lifetime"] = "true";
        foreach (var name in new[] { "start_date", "end_date" })
            if (!string.IsNullOrEmpty((string)body[name])) args[name] = (string)body[name];
        var maxRows = body["max_rows"] != null ? body["max_rows"].Value<int>() : 10000;
        var rows = new JArray();
        foreach (var r in await Report(advertiserId, args, maxRows).ConfigureAwait(false))
        {
            var flat = new JObject();
            foreach (var group in new[] { "dimensions", "metrics" })
                if (r[group] is JObject o)
                    foreach (var p in o.Properties()) flat[p.Name] = p.Value;
            rows.Add(flat);
        }
        return Ok(new JObject { ["advertiser_id"] = advertiserId, ["row_count"] = rows.Count, ["rows"] = rows });
    }

    private async Task<List<JObject>> Report(string advertiserId, Dictionary<string, string> args, int maxRows)
    {
        var rows = new List<JObject>();
        for (var page = 1; ; page++)
        {
            var a = new Dictionary<string, string>(args)
            {
                ["advertiser_id"] = advertiserId,
                ["page"] = page.ToString(),
                ["page_size"] = PageSize.ToString(),
            };
            var data = await Call(HttpMethod.Get, "report/integrated/get/", a, null, true).ConfigureAwait(false);
            foreach (JObject r in (JArray)data["list"] ?? new JArray())
            {
                rows.Add(r);
                if (rows.Count >= maxRows) return rows;
            }
            var totalPages = data["page_info"]?["total_page"]?.Value<int>() ?? 1;
            if (page >= totalPages) return rows;
        }
    }

    // ---- TikTok calls ---------------------------------------------------------------------------

    private async Task<JObject> Call(HttpMethod method, string path, Dictionary<string, string> args, JObject body, bool needsToken)
    {
        var url = ApiBase + path;
        if (args != null && args.Count > 0)
            url += "?" + string.Join("&", args.Select(kv => Uri.EscapeDataString(kv.Key) + "=" + Uri.EscapeDataString(kv.Value)));
        var request = new HttpRequestMessage(method, url);
        if (needsToken)
        {
            var token = Header("Access-Token");
            if (string.IsNullOrWhiteSpace(token)) throw new ArgumentException("Access-Token is required (TikTok Ads Access Token environment variable).");
            request.Headers.TryAddWithoutValidation("Access-Token", token.Trim());
        }
        if (body != null) request.Content = CreateJsonContent(body.ToString(Newtonsoft.Json.Formatting.None));
        var response = await Context.SendAsync(request, CancellationToken).ConfigureAwait(false);
        var text = response.Content != null ? await response.Content.ReadAsStringAsync().ConfigureAwait(false) : "";
        JObject json;
        try { json = string.IsNullOrWhiteSpace(text) ? new JObject() : ParseJson(text); }
        catch (JsonException) { throw new TikTokException(response.IsSuccessStatusCode ? HttpStatusCode.BadGateway : response.StatusCode, 0, "TikTok returned: " + Truncate(text, 500)); }
        var code = json["code"]?.Value<int>() ?? (response.IsSuccessStatusCode ? 0 : -1);
        if (!response.IsSuccessStatusCode || code != 0)
        {
            var status = RateLimitCodes.Contains(code) ? (HttpStatusCode)429
                : response.IsSuccessStatusCode ? HttpStatusCode.BadRequest : response.StatusCode;
            throw new TikTokException(status, code, "TikTok " + path + " failed (code " + code + "): " +
                                                    ((string)json["message"] ?? Truncate(text, 500)) +
                                                    " [request_id " + (string)json["request_id"] + "]");
        }
        return json["data"] as JObject ?? new JObject();
    }

    // TikTok returns times as "YYYY-MM-DD HH:MM:SS" strings; keep them as text.
    private static JObject ParseJson(string text)
    {
        using (var reader = new JsonTextReader(new StringReader(text)) { DateParseHandling = DateParseHandling.None })
            return JObject.Load(reader);
    }

    // ---- flattening -----------------------------------------------------------------------------

    private static JObject Flatten(JObject row, JArray columns, JObject info)
    {
        var flat = new JObject();
        foreach (JArray c in columns)
        {
            var name = (string)c[0];
            var kind = (string)c[1];
            var source = (string)c[2];
            var maxLength = (int)c[3];
            if (kind == "now") { flat[name] = DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ"); continue; }
            if (kind == "raw") { flat[name] = Truncate(row.ToString(Newtonsoft.Json.Formatting.None), RawPayloadMaxLength); continue; }
            if (kind == "info") { flat[name] = Convert(info?[source], "str", maxLength); continue; }
            flat[name] = Convert(row[source], kind, maxLength);
        }
        return flat;
    }

    private static JToken Convert(JToken v, string kind, int maxLength)
    {
        if (IsEmpty(v)) return kind == "enums" ? (JToken)new JArray() : JValue.CreateNull();
        switch (kind)
        {
            case "str":
            case "id":
                return Truncate((v is JArray a ? a.First : v).ToString(), maxLength);
            case "int":
                var n = Number(v);
                return n.HasValue ? (JToken)(long)Math.Round(n.Value) : JValue.CreateNull();
            case "dec":
            case "pct":
            case "money":
                var d = Number(v);
                return d.HasValue ? (JToken)Math.Round(d.Value, kind == "money" ? 4 : 6) : JValue.CreateNull();
            case "bool":
                if (v.Type == JTokenType.Boolean) return v;
                var s = v.ToString().Trim().ToLowerInvariant();
                return s == "true" || s == "1" || s == "on" || s == "enable";
            case "date":
                var t = v.ToString().Trim();
                if (t.Length == 10) t += " 00:00:00";
                return t.Length == 19 ? t.Replace(' ', 'T') + "Z" : t;
            case "enum": return v.ToString();
            // TikTok can send null items inside lists (seen live: ["IN_FEED","SEARCH_FEED",null,null]); drop them.
            case "enums": return new JArray(Items(v).Where(x => !IsEmpty(x)).Select(x => x.ToString()));
            case "strs":
                var lines = Items(v).Where(x => !IsEmpty(x)).Select(x => x.ToString()).ToList();
                return lines.Count == 0 ? JValue.CreateNull() : (JToken)Truncate(string.Join("\n", lines), maxLength);
            case "json": return Truncate(v.ToString(Newtonsoft.Json.Formatting.None), maxLength);
            default: return v;
        }
    }

    // TikTok sends metrics as text ("12.34"); "-" or "" means no value.
    private static double? Number(JToken v)
    {
        if (v.Type == JTokenType.Integer || v.Type == JTokenType.Float) return v.Value<double>();
        var s = v.ToString().Trim().TrimEnd('%').Replace(",", "");
        return double.TryParse(s, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var d)
            ? d : (double?)null;
    }

    private static IEnumerable<JToken> Items(JToken v) => v is JArray a ? (IEnumerable<JToken>)a : new[] { v };

    private static IEnumerable<List<T>> Chunks<T>(List<T> items, int size)
    {
        for (var i = 0; i < items.Count; i += size) yield return items.GetRange(i, Math.Min(size, items.Count - i));
    }

    private static bool IsEmpty(JToken v) =>
        v == null || v.Type == JTokenType.Null || (v is JArray a && a.Count == 0) ||
        (v.Type == JTokenType.String && v.ToString().Length == 0);

    private static string Truncate(string s, int maxLength) =>
        maxLength > 0 && s != null && s.Length > maxLength ? s.Substring(0, maxLength) : s;

    // ---- request helpers ------------------------------------------------------------------------

    private string OperationId()
    {
        var id = Context.OperationId;
        if (id.StartsWith("List") || id.StartsWith("Get") || id == "RunReport") return id;
        try { return Encoding.UTF8.GetString(System.Convert.FromBase64String(id)); }
        catch (FormatException) { return id; }
    }

    private string AdvertiserId()
    {
        var id = (Param("advertiser_id") ?? "").Trim();
        if (!Digits.IsMatch(id)) throw new ArgumentException("advertiser_id must be a TikTok advertiser (ad account) ID.");
        return id;
    }

    private string Required(string name)
    {
        var v = (Param(name) ?? "").Trim();
        if (v.Length == 0) throw new ArgumentException(name + " is required.");
        return v;
    }

    private string Param(string name) => query.TryGetValue(name, out var v) ? v : null;

    private bool Flag(string name, bool fallback)
    {
        var v = Param(name);
        return string.IsNullOrEmpty(v) ? fallback : v.Equals("true", StringComparison.OrdinalIgnoreCase);
    }

    private int MaxRows()
    {
        var v = Param("max_rows");
        return string.IsNullOrEmpty(v) ? int.MaxValue : Math.Max(1, int.Parse(v));
    }

    private string Header(string name) =>
        Context.Request.Headers.TryGetValues(name, out var values) ? values.FirstOrDefault() : null;

    private static Dictionary<string, string> ParseQuery(string q)
    {
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var pair in (q ?? "").TrimStart('?').Split(new[] { '&' }, StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = pair.Split(new[] { '=' }, 2);
            result[Uri.UnescapeDataString(kv[0].Replace('+', ' '))] =
                kv.Length > 1 ? Uri.UnescapeDataString(kv[1].Replace('+', ' ')) : "";
        }
        return result;
    }

    private HttpResponseMessage Ok(JObject body)
    {
        var response = new HttpResponseMessage(HttpStatusCode.OK);
        response.Content = CreateJsonContent(body.ToString(Newtonsoft.Json.Formatting.None));
        return response;
    }

    private HttpResponseMessage Error(HttpStatusCode status, string message)
    {
        var response = new HttpResponseMessage(status);
        response.Content = CreateJsonContent(new JObject
        {
            ["error"] = new JObject { ["code"] = (int)status, ["message"] = message, ["status"] = status.ToString() }
        }.ToString(Newtonsoft.Json.Formatting.None));
        return response;
    }

    private class TikTokException : Exception
    {
        public HttpStatusCode Status { get; }
        public int Code { get; }

        public TikTokException(HttpStatusCode status, int code, string message) : base(message)
        {
            Status = status;
            Code = code;
        }
    }
}
